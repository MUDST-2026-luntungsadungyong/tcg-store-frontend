# Cloudflare Pages build-time variables
VITE_API_BASE_URL=/api
VITE_ENABLE_MOCK_API=false
VITE_APP_TITLE="Mythix TCG Trading"

# Cloudflare Pages Functions runtime variable (set in the Pages dashboard)
# Use the OKE ingress origin only, without a path such as /api.
API_ORIGIN=https://<oke-ingress-host>
