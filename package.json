{
  "name": "tcg-store-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:e2e:full": "cypress run",
    "test:e2e:half": "cypress run --spec \"cypress/e2e/01_*,cypress/e2e/auth/01_*\"",
    "test:e2e:smoke": "cypress run --spec \"cypress/e2e/01_*,cypress/e2e/auth/01_*\"",
    "test:e2e:auth": "cypress run --spec \"cypress/e2e/auth/**/*.cy.ts\"",
    "test:e2e:auth:open": "cypress open",
    "test:e2e:admin": "cypress run --spec \"cypress/e2e/admin/**/*.cy.ts\"",
    "test:e2e:admin-orders": "cypress run --spec \"cypress/e2e/admin/07_admin_orders_monitoring.cy.ts\"",
    "test:e2e:order": "cypress run --spec \"cypress/e2e/04_order_fastforward_lifecycle.cy.ts\"",
    "test:e2e:seller-orders": "cypress run --spec \"cypress/e2e/11_seller_order_management.cy.ts\"",
    "test:e2e:card-detail": "cypress run --spec \"cypress/e2e/12_card_detail_multi_seller_and_recommendations.cy.ts\"",
    "test:e2e:vouchers": "cypress run --spec \"cypress/e2e/13_buyer_vouchers_and_checkout.cy.ts,cypress/e2e/admin/08_admin_vouchers_management.cy.ts,cypress/e2e/19_voucher_admin_buyer_sync.cy.ts\"",
    "test:e2e:vouchers:http": "cypress run --config baseUrl=http://localhost:3001 --spec \"cypress/e2e/design/08_vouchers_http.cy.ts\"",
    "test:e2e:notifications": "cypress run --spec \"cypress/e2e/05_notifications_inbox.cy.ts\"",
    "test:e2e:staging": "cypress run --spec \"cypress/e2e/11_live_staging_reservation_journey.cy.ts\"",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "cypress run --headless",
    "audit": "npm audit --audit-level=critical",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^13.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "cypress": "^16.1.1",
    "jsdom": "^31.0.0",
    "oxlint": "^1.85.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
