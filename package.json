{
  "name": "tcg-store-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "cypress run",
    "test:e2e:full": "cypress run",
    "test:e2e:half": "cypress run --spec \"cypress/e2e/01_*,cypress/e2e/auth/01_*\"",
    "test:e2e:smoke": "cypress run --spec \"cypress/e2e/01_*,cypress/e2e/auth/01_*\"",
    "test:e2e:auth": "cypress run --spec \"cypress/e2e/auth/**/*.cy.ts\"",
    "test:e2e:auth:open": "cypress open",
    "test:e2e:admin": "cypress run --spec \"cypress/e2e/admin/**/*.cy.ts\"",
    "test:e2e:order": "cypress run --spec \"cypress/e2e/04_order_fastforward_lifecycle.cy.ts\"",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "cypress run --headless",
    "audit": "npm audit --audit-level=high",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "cypress": "^16.1.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
